{
  "name": "han-input",
  "compatibility_date": "2026-10-30",
  "main": "worker/index.js",
  // The worker serves the app for known paths and keeps a 404 for everything else.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "han.mkpo.li", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
